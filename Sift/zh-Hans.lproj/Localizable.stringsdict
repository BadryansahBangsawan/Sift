			<key>other</key>
			<string>已检查 %lld 个文件</string>
		</dict>
	</dict>
	<key>%lld files totaling %@ were moved. Every protected copy remains in place.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>已将 %lld 个文件（共 %@）移到废纸篓。所有受保护的副本均已保留。</string>
		</dict>
	</dict>
	<key>%lld files totaling %@ will be moved to Trash. The protected copy in every group stays in place.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>将把 %lld 个文件（共 %@）移到废纸篓。每组中受保护的副本都会保留。</string>
		</dict>
	</dict>
	<key>%lld folders</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 个文件夹</string>
		</dict>
