			<string>%lld fichiers</string>
		</dict>
	</dict>
	<key>%lld files inspected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld fichier inspecté</string>
			<key>other</key>
			<string>%lld fichiers inspectés</string>
		</dict>
	</dict>
	<key>%lld items</key>
