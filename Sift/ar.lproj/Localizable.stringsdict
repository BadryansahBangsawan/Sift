	<key>%lld folders totaling %@ will be moved to Trash. Sift checks each folder again first. Reinstall dependencies or rebuild to get them back.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>سيُنقل %lld مجلدات بإجمالي %@ إلى سلة المهملات. يتحقق Sift من كل مجلد مرة أخرى أولًا. أعد تثبيت التبعيات أو أعد البناء لاستعادتها.</string>
			<key>many</key>
			<string>سيُنقل %lld مجلدًا بإجمالي %@ إلى سلة المهملات. يتحقق Sift من كل مجلد مرة أخرى أولًا. أعد تثبيت التبعيات أو أعد البناء لاستعادتها.</string>
			<key>one</key>
			<string>سيُنقل %lld مجلد بإجمالي %@ إلى سلة المهملات. يتحقق Sift من كل مجلد مرة أخرى أولًا. أعد تثبيت التبعيات أو أعد البناء لاستعادته.</string>
			<key>other</key>
			<string>سيُنقل %lld مجلد بإجمالي %@ إلى سلة المهملات. يتحقق Sift من كل مجلد مرة أخرى أولًا. أعد تثبيت التبعيات أو أعد البناء لاستعادتها.</string>
			<key>two</key>
			<string>سيُنقل %lld مجلدان بإجمالي %@ إلى سلة المهملات. يتحقق Sift من كل مجلد مرة أخرى أولًا. أعد تثبيت التبعيات أو أعد البناء لاستعادتهما.</string>
			<key>zero</key>
			<string>سيُنقل %lld مجلدات بإجمالي %@ إلى سلة المهملات. يتحقق Sift من كل مجلد مرة أخرى أولًا. أعد تثبيت التبعيات أو أعد البناء لاستعادتها.</string>
		</dict>
