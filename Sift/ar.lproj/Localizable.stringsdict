		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld مجلدات بإجمالي %@ في سلة المهملات. أفرغ سلة المهملات لتحرير المساحة.</string>
			<key>many</key>
			<string>%lld مجلدًا بإجمالي %@ في سلة المهملات. أفرغ سلة المهملات لتحرير المساحة.</string>
