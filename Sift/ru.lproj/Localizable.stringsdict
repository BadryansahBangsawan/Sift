	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld приложения</string>
			<key>many</key>
			<string>%lld приложений</string>
			<key>one</key>
			<string>%lld приложение</string>
			<key>other</key>
			<string>%lld приложения</string>
		</dict>
	</dict>
