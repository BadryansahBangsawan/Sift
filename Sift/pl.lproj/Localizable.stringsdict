	<key>%lld files totaling %@ were moved. Every protected copy remains in place.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Przeniesiono %lld pliki o łącznym rozmiarze %@. Każda chroniona kopia pozostaje na miejscu.</string>
			<key>many</key>
			<string>Przeniesiono %lld plików o łącznym rozmiarze %@. Każda chroniona kopia pozostaje na miejscu.</string>
			<key>one</key>
			<string>Przeniesiono %lld plik o łącznym rozmiarze %@. Każda chroniona kopia pozostaje na miejscu.</string>
			<key>other</key>
			<string>Przeniesiono %lld pliku o łącznym rozmiarze %@. Każda chroniona kopia pozostaje na miejscu.</string>
		</dict>
	</dict>
	<key>%lld files totaling %@ will be moved to Trash. The protected copy in every group stays in place.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld pliki o łącznym rozmiarze %@ zostaną przeniesione do kosza. Chroniona kopia w każdej grupie pozostaje na miejscu.</string>
			<key>many</key>
			<string>%lld plików o łącznym rozmiarze %@ zostanie przeniesionych do kosza. Chroniona kopia w każdej grupie pozostaje na miejscu.</string>
			<key>one</key>
			<string>%lld plik o łącznym rozmiarze %@ zostanie przeniesiony do kosza. Chroniona kopia w każdej grupie pozostaje na miejscu.</string>
			<key>other</key>
			<string>%lld pliku o łącznym rozmiarze %@ zostanie przeniesione do kosza. Chroniona kopia w każdej grupie pozostaje na miejscu.</string>
		</dict>
	</dict>
