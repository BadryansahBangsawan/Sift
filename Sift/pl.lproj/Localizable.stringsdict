	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld zdjęcia · %@</string>
			<key>many</key>
			<string>%lld zdjęć · %@</string>
			<key>one</key>
			<string>%lld zdjęcie · %@</string>
			<key>other</key>
			<string>%lld zdjęcia · %@</string>
		</dict>
	</dict>
	<key>Remove %lld files</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Usuń %lld pliki</string>
			<key>many</key>
			<string>Usuń %lld plików</string>
			<key>one</key>
			<string>Usuń %lld plik</string>
			<key>other</key>
			<string>Usuń %lld pliku</string>
		</dict>
	</dict>
	<key>Remove %lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Usuń %lld elementy</string>
			<key>many</key>
			<string>Usuń %lld elementów</string>
			<key>one</key>
			<string>Usuń %lld element</string>
			<key>other</key>
			<string>Usuń %lld elementu</string>
		</dict>
	</dict>
</dict>
</plist>
