	<key>%lld folders have a familiar name but Sift couldn't prove they are generated</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Foldery (%lld) mają znaną nazwę, ale Sift nie mógł udowodnić, że są wygenerowane</string>
			<key>many</key>
			<string>Foldery (%lld) mają znaną nazwę, ale Sift nie mógł udowodnić, że są wygenerowane</string>
			<key>one</key>
			<string>Folder (%lld) ma znaną nazwę, ale Sift nie mógł udowodnić, że jest wygenerowany</string>
			<key>other</key>
			<string>Folderu (%lld) ma znaną nazwę, ale Sift nie mógł udowodnić, że jest wygenerowany</string>
		</dict>
	</dict>
	<key>%lld folders totaling %@ are in the Trash. Empty the Trash to free the space.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Foldery (%lld) o łącznym rozmiarze %@ są w koszu. Opróżnij kosz, aby zwolnić miejsce.</string>
			<key>many</key>
			<string>Foldery (%lld) o łącznym rozmiarze %@ są w koszu. Opróżnij kosz, aby zwolnić miejsce.</string>
			<key>one</key>
			<string>Folder (%lld) o łącznym rozmiarze %@ jest w koszu. Opróżnij kosz, aby zwolnić miejsce.</string>
			<key>other</key>
			<string>Folderu (%lld) o łącznym rozmiarze %@ jest w koszu. Opróżnij kosz, aby zwolnić miejsce.</string>
		</dict>
	</dict>
	<key>%lld folders totaling %@ will be moved to Trash. Sift checks each folder again first. Reinstall dependencies or rebuild to get them back.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Foldery (%lld) o łącznym rozmiarze %@ zostaną przeniesione do kosza. Sift najpierw ponownie sprawdza każdy folder. Aby je odzyskać, zainstaluj ponownie zależności lub przebuduj projekt.</string>
			<key>many</key>
			<string>Foldery (%lld) o łącznym rozmiarze %@ zostaną przeniesione do kosza. Sift najpierw ponownie sprawdza każdy folder. Aby je odzyskać, zainstaluj ponownie zależności lub przebuduj projekt.</string>
			<key>one</key>
			<string>Folder (%lld) o łącznym rozmiarze %@ zostanie przeniesiony do kosza. Sift najpierw ponownie sprawdza każdy folder. Aby go odzyskać, zainstaluj ponownie zależności lub przebuduj projekt.</string>
			<key>other</key>
			<string>Folderu (%lld) o łącznym rozmiarze %@ zostanie przeniesiony do kosza. Sift najpierw ponownie sprawdza każdy folder. Aby go odzyskać, zainstaluj ponownie zależności lub przebuduj projekt.</string>
		</dict>
	</dict>
