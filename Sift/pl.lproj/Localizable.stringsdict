		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld zdjęcia</string>
			<key>many</key>
			<string>%lld zdjęć</string>
			<key>one</key>
			<string>%lld zdjęcie</string>
			<key>other</key>
			<string>%lld zdjęcia</string>
		</dict>
	</dict>
